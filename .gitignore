# Esclude dipendenze, segreti e artefatti locali dal repository.

# Dipendenze e cache dei gestori di pacchetti
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Copertura dei test
/coverage

# File generati da Next.js
/.next/
/out/

# Compilazione di produzione
/build

# File locali del sistema e chiavi private
.DS_Store
*.pem

# Registri diagnostici
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Configurazioni riservate; solo i modelli .env.example vengono pubblicati
.env*

# Configurazione locale della piattaforma Vercel
.vercel

# Cache e dichiarazioni generate da TypeScript
*.tsbuildinfo
next-env.d.ts

!socket-server/.env.example

!.env.example

/test-results/
/playwright-report/

/.next-e2e/

# Istruzioni locali per assistenti, eventualmente rigenerate da Next.js
/AGENTS.md
/CLAUDE.md
/.github/agents/
